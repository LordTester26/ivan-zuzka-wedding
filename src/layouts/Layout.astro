---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { frontmatter } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter?.title || "Ivan a Zuzka <3"}</title>
  </head>

  <script>
    const colorSelected = "text-green-700";
    const colorDefault = "text-zinc-400";
    const fontSelected = "font-medium";
    const fontDefault = "font-normal";
    const sceneSetSelectedBorder = "border-green-700";
    const sceneSetDefaultBorder = "border-zinc-300";

    function detectSceneSet() {
      const saved = localStorage.getItem("sceneSet");
      if (saved === "invitation" || saved === "information") return saved;
      return "information";
    }

    function detectLanguage() {
      const saved = localStorage.getItem("lang");
      if (saved) return saved;

      const langs = navigator.languages || [navigator.language];

      for (const l of langs) {
        if (l.startsWith("sk")) return "sk";
        if (l.startsWith("cs") || l.startsWith("cz")) return "cz";
      }

      return "en";
    }

    function applySceneSet(sceneSet: "invitation" | "information") {

      document.querySelectorAll<HTMLElement>("[data-scene-set-group]").forEach(group => {
        const isSelected = group.dataset.sceneSetGroup === sceneSet;
        group.classList.toggle("hidden", !isSelected);
      });

      const langContainer = document.querySelector<HTMLElement>(".lang-switcher");
      if (langContainer) {
        langContainer.classList.toggle("hidden", sceneSet === "information");
      }

      document.querySelectorAll<HTMLButtonElement>(".scene-set-btn").forEach(btn => {

        btn.classList.remove(colorSelected, fontSelected, sceneSetSelectedBorder);
        btn.classList.add(colorDefault, fontDefault, sceneSetDefaultBorder);

        if (btn.dataset.sceneSet === sceneSet) {
          btn.classList.remove(colorDefault, fontDefault, sceneSetDefaultBorder);
          btn.classList.add(colorSelected, fontSelected, sceneSetSelectedBorder);
        }

      });

    }

    function applyLanguage(lang: string) {

      // update scenes
      const scenes = document.querySelectorAll<HTMLImageElement>(".scene-img");

      scenes.forEach(img => {
        const sceneName = img.dataset.scene;
        img.src = `/scenes/${lang}_${sceneName}.svg`;
      });

      // update button highlight
      document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach(btn => {

        btn.classList.remove(colorSelected, fontSelected);
        btn.classList.add(colorDefault, fontDefault);

        if (btn.dataset.lang === lang) {
          btn.classList.remove(colorDefault, fontDefault);
          btn.classList.add(colorSelected, fontSelected);
        }

      });
    }

    document.addEventListener("DOMContentLoaded", () => {

      const lang = detectLanguage();
      applyLanguage(lang);

      const sceneSet = detectSceneSet();
      applySceneSet(sceneSet);

      document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach(btn => {

        btn.addEventListener("click", () => {

          const lang = btn.dataset.lang;
          if (!lang) return;

          localStorage.setItem("lang", lang);

          applyLanguage(lang);

        });

      });

      document.querySelectorAll<HTMLButtonElement>(".scene-set-btn").forEach(btn => {

        btn.addEventListener("click", () => {

          const sceneSet = btn.dataset.sceneSet as "invitation" | "information";

          localStorage.setItem("sceneSet", sceneSet);

          applySceneSet(sceneSet);

        });

      });

    });
  </script>

  <body class="min-h-screen flex flex-col">

    <Header />    

    <main class="flex-1 overflow-y-auto">
      <slot />
    </main>

    <Footer />

  </body>

</html>