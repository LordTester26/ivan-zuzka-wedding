<!-- Header -->
<header class="px-6 py-3 border-b border-white">
  <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">

    <!-- Scene set switcher -->
    <div class="flex gap-2 text-sm">
      <button data-scene-set="invitation" class="scene-set-btn px-3 py-1 rounded-full text-zinc-400 border border-zinc-300 hover:text-fuchsia-950 hover:border-fuchsia-500">Pozvánka</button>
      <button data-scene-set="information" class="scene-set-btn px-3 py-1 rounded-full text-zinc-400 border border-zinc-300 hover:text-fuchsia-950 hover:border-fuchsia-500">Info</button>
    </div>

    <!-- Language switcher -->
    <div class="flex gap-3 text-lg lang-switcher">
      <button data-lang="sk" class="lang-btn px-2 py-1 text-zinc-400 hover:text-fuchsia-950">SK</button>
      <button data-lang="cz" class="lang-btn px-2 py-1 text-zinc-400 hover:text-fuchsia-950">CZ</button>
      <button data-lang="en" class="lang-btn px-2 py-1 text-zinc-400 hover:text-fuchsia-950">EN</button>
    </div>

  </div>
</header>